# AI
GEMINI_API_KEY=your_gemini_api_key

# Vercel / PostgreSQL (Neon or another managed PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Authentication
# Do NOT put these secrets in React/Vite client code.
ADMIN_USERNAME=server_utama
ADMIN_PASSWORD=CHANGE_THIS_TO_YOUR_SERVER_PASSWORD
REGISTER_TOKEN=CHANGE_THIS_TO_YOUR_PRIVATE_REGISTRATION_TOKEN
AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Local development
PORT=3000
